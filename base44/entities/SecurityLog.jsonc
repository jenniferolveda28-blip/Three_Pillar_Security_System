{
  "name": "SecurityLog",
  "type": "object",
  "properties": {
    "event_type": {
      "type": "string",
      "enum": [
        "key_rotation",
        "access_granted",
        "access_denied",
        "dna_verified",
        "suspicious_activity",
        "endpoint_group_accessed",
        "token_activation_failure"
      ],
      "description": "Type of security event"
    },
    "endpoint_group_id": {
      "type": "string",
      "description": "Which Protected Endpoint Group was accessed"
    },
    "dna_hash": {
      "type": "string",
      "description": "Hashed DNA signature (unique genetic code)"
    },
    "ip_address": {
      "type": "string",
      "description": "Request origin"
    },
    "success": {
      "type": "boolean",
      "default": true
    },
    "details": {
      "type": "string",
      "description": "Additional security details"
    },
    "threat_level": {
      "type": "string",
      "enum": [
        "none",
        "low",
        "medium",
        "high",
        "critical"
      ],
      "default": "none"
    }
  },
  "required": [
    "event_type"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "$and": [
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "data.event_type": {
                "$in": [
                  "suspicious_activity",
                  "token_activation_failure"
                ]
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "auditor"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "auditor"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
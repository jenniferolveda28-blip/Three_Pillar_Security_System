{
  "name": "BioVerifyToken",
  "type": "object",
  "properties": {
    "device_name": {
      "type": "string",
      "description": "Name of the physical BioVerify hardware token"
    },
    "device_id": {
      "type": "string",
      "description": "Unique hardware identifier (can't be cloned)"
    },
    "secret_key": {
      "type": "string",
      "description": "TOTP secret (stored encrypted)"
    },
    "current_code": {
      "type": "string",
      "description": "Current 6-digit code (changes every 2 seconds)"
    },
    "last_code_generated": {
      "type": "string",
      "format": "date-time",
      "description": "When the code was last generated"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Is this token authorized"
    },
    "last_used": {
      "type": "string",
      "format": "date-time",
      "description": "Last successful authentication"
    },
    "failed_attempts": {
      "type": "number",
      "default": 0,
      "description": "Failed auth attempts (auto-locks at 3)"
    },
    "battery_level": {
      "type": "number",
      "default": 100,
      "description": "Battery percentage 0-100"
    },
    "last_sync_date": {
      "type": "string",
      "format": "date-time",
      "description": "Last cloud synchronization timestamp"
    },
    "sync_status": {
      "type": "string",
      "enum": [
        "synced",
        "syncing",
        "offline",
        "error"
      ],
      "default": "synced",
      "description": "Current sync state"
    },
    "firmware_version": {
      "type": "string",
      "description": "Installed firmware version"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional description or notes"
    }
  },
  "required": [
    "device_name",
    "device_id",
    "secret_key"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
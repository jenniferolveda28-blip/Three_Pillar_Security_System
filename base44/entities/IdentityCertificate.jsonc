{
  "name": "IdentityCertificate",
  "type": "object",
  "properties": {
    "certificate_name": {
      "type": "string",
      "description": "Name/title of the identity certificate"
    },
    "auditor_email": {
      "type": "string",
      "description": "Auditor the certificate was issued to/for"
    },
    "user_email": {
      "type": "string",
      "description": "Subject user the certificate covers"
    },
    "token_serial": {
      "type": "string",
      "description": "BioVerify token serial referenced"
    },
    "drive_file_url": {
      "type": "string",
      "description": "Link to the certificate file on Google Drive"
    },
    "generated_date": {
      "type": "string",
      "format": "date-time",
      "description": "When the certificate was generated"
    },
    "status": {
      "type": "string",
      "enum": [
        "issued",
        "verified",
        "expired",
        "revoked"
      ],
      "default": "issued"
    },
    "notes": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "certificate_name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "auditor"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
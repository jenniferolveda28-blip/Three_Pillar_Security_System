{
  "name": "SecurityConfig",
  "type": "object",
  "properties": {
    "config_name": {
      "type": "string",
      "default": "default",
      "description": "Name of the security policy profile"
    },
    "dark_web_scan_frequency_hours": {
      "type": "number",
      "default": 24,
      "description": "How often to scan the dark web"
    },
    "exposure_scan_frequency_hours": {
      "type": "number",
      "default": 168,
      "description": "How often to scan data brokers"
    },
    "alert_sensitivity_threshold": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "default": "medium",
      "description": "Minimum severity to raise an alert"
    },
    "auto_removal_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Auto-open removal requests for critical findings"
    },
    "rotation_interval_seconds": {
      "type": "number",
      "default": 5,
      "description": "CipherPass key rotation interval"
    },
    "notify_email": {
      "type": "string",
      "description": "Email to receive security notifications"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "config_name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "auditor"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
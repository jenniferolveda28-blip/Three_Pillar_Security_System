{
  "name": "Send Intro Email on Interested",
  "description": "Sends a professional introductory email with technical overview when an investor is marked as Interested",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"status\") != null) and (.trigger.data.status == \"Interested\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "InvestorMeeting"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "send_intro_email_on_interested",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendInvestorIntroEmail",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "sendInvestorIntroEmail"
  }
}